# ---- Supabase ----
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Used by the ingest API route to insert
# alerts while bypassing row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Device ingest auth ----
# Shared secret the Raspberry Pi must send in the `x-api-key` header.
DEVICE_API_KEY=change-me-to-a-long-random-string
